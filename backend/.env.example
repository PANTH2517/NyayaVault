# NyayaVault Backend Environment Variables Placeholder Template

PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Configuration (Milestone 2)
# Obtain these URLs from your Supabase Dashboard under Settings -> Database -> Connection Strings
#
# Connection Pooler URL (Transaction Mode / PgBouncer on port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Database URL for Prisma Migrations (Session Mode on port 5432):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication (Milestone 3)
JWT_SECRET=your_jwt_secret_key_placeholder
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_placeholder
REFRESH_TOKEN_EXPIRATION=7d

# Supabase Private Storage (Milestone 5)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=nyayavault-documents

# Hackathon Demo Controlled Tamper Simulator
TAMPER_SIMULATION_ENABLED=true
