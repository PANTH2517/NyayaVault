// NyayaVault Prisma Schema Definition
// Database & Storage: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------------------------
// Enums
// --------------------------------------------------------

enum RoleName {
  ADMIN
  INVESTIGATING_OFFICER
  SUPERVISOR
  PROSECUTOR
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  CLOSED
  ARCHIVED
}

enum DocumentClassification {
  RESTRICTED
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum DocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  SEALED
}

enum AuditEventType {
  LOGIN
  LOGIN_FAILED
  DOCUMENT_UPLOADED
  DOCUMENT_VIEWED
  DOCUMENT_DOWNLOADED
  DOCUMENT_VERSION_CREATED
  DOCUMENT_STATUS_CHANGED
  DOCUMENT_APPROVED
  DOCUMENT_ACCESS_DENIED
  CASE_ACCESS_GRANTED
  CASE_ACCESS_REVOKED
  INTEGRITY_VERIFIED
  INTEGRITY_FAILED
  SECURITY_INCIDENT_CREATED
  REGISTRATION_REQUESTED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  MFA_ENROLLMENT_STARTED
  MFA_ENABLED
  MFA_LOGIN_SUCCESS
  MFA_LOGIN_FAILURE
  MFA_RECOVERY_CODE_USED
  MFA_RECOVERY_CODES_REGENERATED
  MFA_DISABLED
  MFA_ADMIN_RESET
  SHARE_CREATED
  SHARE_ACCESSED
  SHARE_ACCESS_DENIED
  SHARE_REVOKED
  SHARE_EXPIRED
}

enum ShareStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IncidentType {
  DOCUMENT_TAMPER_DETECTED
  AUDIT_CHAIN_VERIFICATION_FAILED
  REPEATED_UNAUTHORIZED_ACCESS
  SUSPICIOUS_DOCUMENT_ACTION
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// --------------------------------------------------------
// Models
// --------------------------------------------------------

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  passwordHash          String
  fullName              String
  role                  RoleName              @default(INVESTIGATING_OFFICER)
  refreshTokenHash      String?
  isActive              Boolean               @default(true)
  mfaEnabled            Boolean               @default(false)
  mfaSecretEncrypted    String?
  mfaEnrolledAt         DateTime?
  mfaLastUsedTimeStep   Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  caseAssignments       CaseAssignment[]
  createdCases          Case[]                @relation("CaseCreator")
  uploadedVersions      DocumentVersion[]     @relation("VersionUploader")
  auditEvents           AuditEvent[]
  requestedApprovals    Approval[]           @relation("ApprovalRequester")
  decidedApprovals      Approval[]           @relation("ApprovalDecider")
  sessions              UserSession[]
  resetTokens           PasswordResetToken[]
  reviewedRegistrations RegistrationRequest[] @relation("RegistrationReviewer")
  mfaRecoveryCodes      MfaRecoveryCode[]
  issuedShares          EvidenceShare[]       @relation("ShareIssuer")
  receivedShares        EvidenceShare[]       @relation("ShareRecipient")
  revokedShares         EvidenceShare[]       @relation("ShareRevoker")

  @@map("users")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model RegistrationRequest {
  id              String             @id @default(uuid())
  email           String             @unique
  fullName        String
  passwordHash    String
  requestedRole   RoleName           @default(INVESTIGATING_OFFICER)
  status          RegistrationStatus @default(PENDING)
  reviewedById    String?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  reviewedBy      User?              @relation("RegistrationReviewer", fields: [reviewedById], references: [id])

  @@map("registration_requests")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model Case {
  id           String             @id @default(uuid())
  caseNumber   String             @unique
  title        String
  description  String?
  status       CaseStatus         @default(OPEN)
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy    User               @relation("CaseCreator", fields: [createdById], references: [id])
  assignments  CaseAssignment[]
  documents    Document[]
  auditEvents  AuditEvent[]
  incidents    SecurityIncident[]
  evidenceShares EvidenceShare[]

  @@map("cases")
}

model CaseAssignment {
  id         String   @id @default(uuid())
  caseId     String
  userId     String
  roleInCase String?
  assignedAt DateTime @default(now())

  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@map("case_assignments")
}

model Document {
  id               String                 @id @default(uuid())
  caseId           String
  title            String
  documentType     String
  classification   DocumentClassification @default(CONFIDENTIAL)
  currentStatus    DocumentStatus         @default(DRAFT)
  currentVersionId String?                @unique
  createdById      String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  case             Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]      @relation("DocumentToVersions")
  auditEvents      AuditEvent[]
  approvals        Approval[]
  incidents        SecurityIncident[]

  @@map("documents")
}

model DocumentVersion {
  id                String             @id @default(uuid())
  documentId        String
  versionNumber     Int
  storagePath       String
  fileSizeBytes     BigInt
  mimeType          String
  sha256Hash        String
  isCompromised       Boolean            @default(false)
  changeDescription   String?
  encryptionVersion   Int?
  encryptionKeyVersion Int?
  isEncrypted         Boolean            @default(false)
  createdById         String
  createdAt           DateTime           @default(now())

  document          Document           @relation("DocumentToVersions", fields: [documentId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("VersionUploader", fields: [createdById], references: [id])
  auditEvents       AuditEvent[]
  approvals         Approval[]
  incidents         SecurityIncident[]
  shares            EvidenceShare[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model AuditEvent {
  id                String          @id @default(uuid())
  sequenceNumber    BigInt          @unique @default(autoincrement())
  eventType         AuditEventType
  userId            String?
  caseId            String?
  documentId        String?
  versionId         String?
  action            String
  ipAddress         String?
  userAgent         String?
  metadata          Json?
  previousEventHash String?
  currentEventHash  String
  createdAt         DateTime        @default(now())

  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  case              Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  document          Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  version           DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([sequenceNumber])
  @@index([caseId])
  @@index([documentId])
  @@map("audit_events")
}

model Approval {
  id            String         @id @default(uuid())
  documentId    String
  versionId     String
  requestedById String
  approvedById  String?
  status        DocumentStatus @default(UNDER_REVIEW)
  comments      String?
  requestedAt   DateTime       @default(now())
  decidedAt     DateTime?

  document      Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestedBy   User            @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvedBy    User?           @relation("ApprovalDecider", fields: [approvedById], references: [id])

  @@map("approvals")
}

model SecurityIncident {
  id          String           @id @default(uuid())
  incidentType IncidentType
  severity    IncidentSeverity @default(HIGH)
  caseId      String?
  documentId  String?
  versionId   String?
  status      IncidentStatus   @default(OPEN)
  description String
  detectedAt  DateTime         @default(now())
  resolvedAt  DateTime?

  case        Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  document    Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  version     DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@map("security_incidents")
}

// --------------------------------------------------------
// Sub-Phase 1E: Permissioned Blockchain Storage Models
// --------------------------------------------------------

model BlockchainChain {
  id               String   @id @default(uuid())
  nodeId           String
  chainId          String
  currentHeight    BigInt   @default(0)
  currentBlockHash String
  genesisBlockHash String
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([nodeId, chainId])
  @@map("blockchain_chains")
}

model BlockchainBlock {
  id                String   @id @default(uuid())
  nodeId            String
  chainId           String
  height            BigInt
  blockHash         String
  previousBlockHash String
  merkleRoot        String
  timestamp         String
  version           String   @default("1.0")
  proposerNode      String
  createdAt         DateTime @default(now())

  transactions   BlockchainTransaction[]
  consensusProof BlockchainConsensusProof?

  @@unique([nodeId, chainId, height])
  @@unique([nodeId, chainId, blockHash])
  @@index([nodeId, chainId, previousBlockHash])
  @@map("blockchain_blocks")
}

model BlockchainTransaction {
  id              String   @id @default(uuid())
  txId            String
  blockId         String
  nodeId          String
  chainId         String
  txIndex         Int
  txType          String
  originatingNode String
  nonce           BigInt
  payload         Json
  signatureHex    String
  timestamp       String
  keyVersion      Int      @default(1)
  keyFingerprint  String
  createdAt       DateTime @default(now())

  block BlockchainBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, txIndex])
  @@unique([nodeId, chainId, txId])
  @@index([txId])
  @@map("blockchain_transactions")
}

model BlockchainConsensusProof {
  id                String   @id @default(uuid())
  blockId           String   @unique
  nodeId            String
  chainId           String
  consensusType     String   @default("PROOF_OF_AUTHORITY")
  consensusVersion  String   @default("1.0")
  proposalId        String
  blockHash         String
  blockHeight       String
  policyId          String
  policyVersion     String
  requiredThreshold Int
  requiredNodeIds   Json
  collectedAt       String
  commitTimestamp   String
  createdAt         DateTime @default(now())

  block        BlockchainBlock         @relation(fields: [blockId], references: [id], onDelete: Cascade)
  endorsements BlockchainEndorsement[]

  @@map("blockchain_consensus_proofs")
}

model BlockchainEndorsement {
  id             String   @id @default(uuid())
  proofId        String
  endorserNodeId String
  keyVersion     Int
  keyFingerprint String
  publicKeyPem   String
  signatureHex   String
  signedAt       String
  createdAt      DateTime @default(now())

  proof BlockchainConsensusProof @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@unique([proofId, endorserNodeId])
  @@map("blockchain_endorsements")
}

enum BlockchainAnchorStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
  REJECTED
}

model BlockchainApplicationAnchor {
  id                  String                 @id @default(uuid())
  idempotencyKey      String                 @unique
  eventType           String
  policyId            String                 @default("STANDARD_ANCHOR")
  originatingNode     String
  caseId              String?
  documentId          String?
  versionId           String?
  auditSequenceNumber BigInt?
  evidenceHash        String?
  blockchainTxId      String?
  blockHash           String?
  blockHeight         BigInt?
  status              BlockchainAnchorStatus @default(PENDING)
  failureReason       String?
  confirmedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([idempotencyKey])
  @@index([versionId])
  @@index([documentId])
  @@index([caseId])
  @@index([status])
  @@map("blockchain_application_anchors")
}

// --------------------------------------------------------
// Phase 1T: Secure Time-Bound Evidence Sharing
// --------------------------------------------------------

model EvidenceShare {
  id           String      @id @default(uuid())
  versionId    String
  caseId       String
  issuedById   String
  targetUserId String
  tokenHash    String      @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedById  String?
  status       ShareStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  version    DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  case       Case            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  issuedBy   User            @relation("ShareIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  targetUser User            @relation("ShareRecipient", fields: [targetUserId], references: [id], onDelete: Restrict)
  revokedBy  User?           @relation("ShareRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([versionId])
  @@index([caseId])
  @@index([targetUserId])
  @@index([issuedById])
  @@map("evidence_shares")
}
