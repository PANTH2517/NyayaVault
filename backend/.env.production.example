# ==============================================================================
# NYAYAVAULT BACKEND — PRODUCTION ENVIRONMENT TEMPLATE
# File: backend/.env.production.example
# ==============================================================================
# SECURITY NOTICE:
# DO NOT commit real production passwords, keys, or secrets to Git repository.
# Use this template to configure environment variables in your Render backend settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Target execution environment ('production' enforces secure HTTP-only cookies and strict error sanitization)
NODE_ENV=production

# HTTP server listening port (Automatically assigned by Render; fallback: 10000)
PORT=10000

# Primary allowed frontend origin for strict CORS validation (No trailing slashes, no wildcard '*')
# Example: https://nyayavault.vercel.app
FRONTEND_URL=<YOUR_VERCEL_PRODUCTION_URL>


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Transaction Pooler Connection URL (PgBouncer - Port 6543)
# Used by NestJS backend application at runtime for lightweight connection pooling.
# Format: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=<YOUR_SUPABASE_TRANSACTION_POOLER_URL>

# Direct Connection URL (Session Mode - Port 5432)
# Used by Prisma CLI for running schema migrations (npx prisma migrate deploy).
# Format: postgres://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL=<YOUR_SUPABASE_DIRECT_DATABASE_URL>


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & TOKEN SECRETS
# ------------------------------------------------------------------------------
# Cryptographically strong 256-bit secret key used for signing short-lived access JWTs.
# GENERATE GENERATING INSTRUCTION: Run `openssl rand -base64 48` in terminal to generate.
# MUST BE UNIQUE AND DIFFERENT FROM REFRESH_TOKEN_SECRET.
JWT_SECRET=<GENERATE_STRONG_256_BIT_SECRET_KEY>

# Access token expiration duration (Default: 15m)
JWT_EXPIRATION=15m

# Cryptographically strong 256-bit secret key used for signing long-lived refresh tokens.
# GENERATE GENERATING INSTRUCTION: Run `openssl rand -base64 48` in terminal to generate.
# MUST BE UNIQUE AND DIFFERENT FROM JWT_SECRET.
REFRESH_TOKEN_SECRET=<GENERATE_DIFFERENT_STRONG_256_BIT_SECRET_KEY>

# Refresh token expiration duration (Default: 7d)
REFRESH_TOKEN_EXPIRATION=7d

# Refresh Cookie SameSite attribute ('lax', 'strict', or 'none'. Default: lax)
COOKIE_SAME_SITE=none


# ------------------------------------------------------------------------------
# 4. PRIVATE SUPABASE STORAGE BUCKET INTEGRATION
# ------------------------------------------------------------------------------
# Supabase Project API URL (Found in Supabase Dashboard -> Settings -> API)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>

# Supabase Service-Role Key (Found in Supabase Dashboard -> Settings -> API -> service_role)
# CRITICAL SECURITY WARNING: This key has full administrative storage & database access.
# KEEP THIS KEY ON THE BACKEND ONLY. NEVER ADD THIS KEY TO FRONTEND / VERCEL.
SUPABASE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# Private Supabase storage bucket name for cryptographic evidence files
SUPABASE_STORAGE_BUCKET=nyayavault-documents


# ------------------------------------------------------------------------------
# 5. SMTP EMAIL DELIVERY CONFIGURATION (PASSWORD RESET)
# ------------------------------------------------------------------------------
# PRODUCTION SMTP REQUIREMENTS:
# SMTP configuration is required in production for password reset delivery.
# Obtain credentials from your email delivery provider (SendGrid, Postmark, AWS SES, Mailgun, etc.).
# Note: If SMTP credentials are not configured, password reset attempts in production will fail closed
# without exposing or logging password reset tokens.

# SMTP Server hostname (e.g., smtp.sendgrid.net, smtp.mailgun.org, smtp.gmail.com)
SMTP_HOST=<YOUR_SMTP_HOST>

# SMTP Server port (Default: 587 for STARTTLS or 465 for TLS)
SMTP_PORT=587

# SMTP Authentication Username
SMTP_USER=<YOUR_SMTP_USERNAME>

# SMTP Authentication Password or API Password (Do NOT use personal account passwords)
SMTP_PASS=<YOUR_SMTP_PASSWORD_OR_API_KEY>

# Verified Sender Email Address
SMTP_FROM="NyayaVault Security" <no-reply@nyayavault.gov.in>


# ------------------------------------------------------------------------------
# 6. SECURITY CONTROLS & DEMO FLAGS
# ------------------------------------------------------------------------------
# Hackathon demo tamper simulator flag. MUST BE SET TO 'false' IN PRODUCTION.
TAMPER_SIMULATION_ENABLED=false
