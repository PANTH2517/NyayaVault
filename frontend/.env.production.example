# ==============================================================================
# NYAYAVAULT FRONTEND — PRODUCTION ENVIRONMENT TEMPLATE
# File: frontend/.env.production.example
# ==============================================================================
# SECURITY NOTICE:
# The frontend bundle is exposed to the browser.
# DO NOT place backend secrets, database connection strings, JWT secrets,
# Supabase service-role keys, or SMTP passwords in frontend environment variables.
# ==============================================================================

# Public HTTPS API endpoint URL pointing to your deployed Render NestJS backend API root.
# Example: https://nyayavault-backend.onrender.com/api/v1
# IMPORTANT: Include /api/v1 suffix.
VITE_API_BASE_URL=<YOUR_RENDER_BACKEND_HTTPS_URL>/api/v1
